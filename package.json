{
  "name": "@its-100rabh/react-native-event-calendar",
  "version": "1.0.0",
  "description": "A standalone, lightweight, highly customizable event and booking calendar component for React Native.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:esm": "tsc -p tsconfig.build.json --module esnext --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir lib/typescript",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "clean": "rimraf lib",
    "test": "node src/__tests__/calendarLogic.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "calendar",
    "event-calendar",
    "booking",
    "react-component",
    "date-picker",
    "typescript"
  ],
  "author": "Saurabh Mahapatra <saurabhmahapatra03@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "dependencies": {
    "date-fns": "^3.6.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.3"
  }
}
